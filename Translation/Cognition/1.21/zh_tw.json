  "============ DESCRIPTIONS ===================": "=====================",

  "tooltip.cognition.shift_for_info": "§8§o按住 SHIFT 取得更多資訊",
  "item.cognition.attunement_staff.description": "用於綁定、查詢，以及設定本模組的方塊。.",
  "item.cognition.enlightened_amulet.description": "將附近的經驗球傳送至你身邊，並將其匯聚以便吸收。\n§nSHIFT + §n點擊右鍵§r來開關功能",
  "item.cognition.nightmare_bottle.description": "大幅加劇你的失眠程度，幾乎保證夜魅生成。",
  "item.cognition.daydream_bottle.description": "重設你的失眠狀態，防止夜魅生成。",
  "item.cognition.bibliophage.description": "侵染書櫃，並在此過程中產生經驗值。\n對著有效的書櫃使用即可對其侵染。",
  "item.cognition.fluorescent_jelly.description": "立即食用！有益於消化。",
  "item.cognition.mending_neurogel.description": "恢復受損物品的耐久度。\n在物品欄中，拿在游標上對著物品點擊來套用。\n同樣可以在鐵砧中使用。",
  "item.cognition.flask_of_poseidon.description": "透過消耗經驗，在世界上放置一格水。",
  "item.cognition.flask_of_hades.description": "透過消耗經驗，在世界上放置一格熔岩。",
  "item.cognition.flask_of_chaos.description": "透過消耗經驗，將世界上的一格液體消除。",
  "item.cognition.transforming_focus.description": "使重組儀能夠執行轉化配方。",
  "item.cognition.memory_tablet.description": "遠端存取方尖碑並從中取回經驗。\n對著方尖碑 §nSHIFT + 點擊右鍵§r來與其綁定。",
  "item.cognition.fortuitous_amulet.description": "為你帶來好運！\n繼承啟蒙護身符的特性，並增加生物掉落的經驗值。",
  "block.cognition.experience_obelisk.description": "儲存與取出經驗。\n會被動地吸收附近的經驗球。",
  "block.cognition.experience_fountain.description": "以可調整的速度發射經驗球。\n使用前需要先綁定方尖碑。",
  "block.cognition.precision_dispeller.description": "指定移除裝備或工具上的附魔與詛咒。",
  "block.cognition.molecular_metamorpher.description": "使用高度濃縮的經驗光束轟擊材料，\n將它們轉化為更先進的材料。\n使用前需要先綁定方尖碑。",
  "block.cognition.accelerator.description": "朝著面對的方向發射實體。",
  "block.cognition.linear_accelerator.description": "朝著箭頭指向的方向發射實體。",
  "block.cognition.archivers_bookshelf.description": "在附魔台周圍使用時，提供 1.5 附魔能力加成。",
  "block.cognition.enchanted_bookshelf.description": "在附魔台周圍使用時，提供 2.0 附魔能力加成。",
  "block.cognition.infected_bookshelf.description": "隨時間緩慢地腐朽，並在此過程中釋放經驗球。",
  "block.cognition.infected_archivers_bookshelf.description": "隨時間緩慢地腐朽，並在此過程中釋放經驗球。\n持續時間是普通書櫃的兩倍。",
  "block.cognition.infected_enchanted_bookshelf.description": "隨時間緩慢地腐朽，並在此過程中釋放經驗球。\n持續時間與釋放的經驗量，是普通書櫃的兩倍。",
  "block.cognition.whisperglass.description": "非常滑溜的方塊，類似於冰塊。",
  "block.cognition.fluorescent_agar.description": "一塊營養的果凍。\n受書蟲侵染後，會轉化成營養瓊脂。",
  "block.cognition.nutrient_agar.description": "不會腐朽的侵染性方塊。侵染速率緩慢。",
  "block.cognition.insightful_agar.description": "一種侵染性方塊，用於加快周圍書櫃的腐朽速度。",
  "block.cognition.extravagant_agar.description": "一種侵染性方塊，用於增加周圍書櫃產生的經驗量。",

