  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.zombieDungeon": "Zombie Dungeons",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.zombieDungeon.@Tooltip": "Zombie Dungeons",
