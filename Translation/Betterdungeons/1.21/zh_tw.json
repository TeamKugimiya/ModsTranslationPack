  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.@Tooltip": "Small Nether Dungeons",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableHeads": "Enable Skulls & Heads",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableHeads.@Tooltip[0]": "Whether or not dungeons should be allowed to place skeleton skulls and other mob heads.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableHeads.@Tooltip[1]": "This option may be useful for some modpack creators.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableHeads.@Tooltip[2]": "Default: true",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.removeVanillaDungeons": "Remove Vanilla Dungeons",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.removeVanillaDungeons.@Tooltip[0]": "Whether or not vanilla dungeons should be prevented from spawning in the world.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.removeVanillaDungeons.@Tooltip[1]": "It is recommended to disable these, since the Small Dungeons are very similar in design.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.removeVanillaDungeons.@Tooltip[2]": "Default: true",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks": "Enable Nether Blocks in Dungeons",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks.@Tooltip[0]": "Some dungeons can rarely spawn Nether-related blocks such as soul sand, soul campfires, and soul lanterns.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks.@Tooltip[1]": "Note that the blocks will be purely decorative - nothing progression-breaking like Ancient Debris.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks.@Tooltip[2]": "Set this to false to prevent any Nether-related blocks from spawning in dungeons.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks.@Tooltip[3]": "This option may be useful for some modpack creators.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks.@Tooltip[4]": "Default: true",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.zombieDungeon.zombieDungeonMaxSurfaceStaircaseLength": "Zombie Dungeon Surface Entrance Staircase Max Length",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.zombieDungeon.zombieDungeonMaxSurfaceStaircaseLength.@Tooltip[0]": "The longest distance that can be checked when attempting to generate a surface entrance staircase.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.zombieDungeon.zombieDungeonMaxSurfaceStaircaseLength.@Tooltip[1]": "Making this too large may cause problems.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.zombieDungeon.zombieDungeonMaxSurfaceStaircaseLength.@Tooltip[2]": "Default: 20",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.bannerMaxCount": "Small Dungeon Max Banner Count",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.bannerMaxCount.@Tooltip[0]": "The maximum number of banners that can spawn in a single small dungeon.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.bannerMaxCount.@Tooltip[1]": "Default: 2",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMinCount": "Small Dungeon Min Chest Count",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMinCount.@Tooltip[0]": "The minimum number of chests that are guaranteed to spawn in a single small dungeon.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMinCount.@Tooltip[1]": "Default: 1",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMaxCount": "Small Dungeon Max Chest Count",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMaxCount.@Tooltip[0]": "The maximum number of chests that are guaranteed to spawn in a single small dungeon.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMaxCount.@Tooltip[1]": "Default: 2",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.enableOreProps": "Allow Ore Blocks in Corners",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.enableOreProps.@Tooltip[0]": "Whether or not Small Dungeons can rarely place ore blocks in the corners of the dungeon.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.enableOreProps.@Tooltip[1]": "If this is set to false, any ore blocks that spawn as part of a corner prop will instead be replaced with air.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.enableOreProps.@Tooltip[2]": "Default: true",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.bannerMaxCount": "Small Nether Dungeon Max Banner Count",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.bannerMaxCount.@Tooltip[0]": "The maximum number of banners that can spawn in a single small Nether dungeon.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.bannerMaxCount.@Tooltip[1]": "Default: 2",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.enabled": "Enable Small Nether Dungeons",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.enabled.@Tooltip": "Whether or not small Nether dungeons should spawn.",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.witherSkeletonsDropWitherSkulls": "Wither Skeletons From Spawners Drop Skulls",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.witherSkeletonsDropWitherSkulls.@Tooltip": "Whether wither skeletons spawned from small Nether dungeons can drop wither skeleton skulls.",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.blazesDropBlazeRods": "Blazes From Spawners Drop Blaze Rods",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.blazesDropBlazeRods.@Tooltip": "Whether blazes spawned from small Nether dungeons have a chance to drop blaze rods."
}
